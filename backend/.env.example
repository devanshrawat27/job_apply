# ---------------------------------------------------------------- database
# SQLite by default (dev). For Postgres use:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobpilot
DATABASE_URL=sqlite:///./jobpilot.db

# ------------------------------------------------------------------- server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------- LLM
# Any OpenAI-compatible endpoint. Google Gemini works too:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Optional: comma separated fallback keys (rotation on quota / rate limit)
LLM_API_KEYS=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_S=90

# ----------------------------------------------------------------- executor
# Node + Playwright scripts live in backend/executor
AUTOMATION_ENABLED=true
AUTOMATION_TIMEOUT_S=180
AUTOMATION_HEADLESS=false

# X sign-in (password is used once, never stored)
X_LOGIN_TIMEOUT_S=210

# Optional: raises the public GitHub API limit when syncing a profile
GITHUB_TOKEN=

# Encrypts the stored X session cookies. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ----------------------------------------------------------------- scheduler
# Background scanner. 0 disables it (use "Run now" in the UI instead).
SCHEDULER_ENABLED=true

# --------------------------------------------------------------------- email
# Optional: lets the agent apply by email when a post gives an address.
# Gmail: use an App Password, not your normal password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-app-password
#   SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Auth
AUTH_ENABLED=true
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
